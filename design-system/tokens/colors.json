{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$version": "1.0.0",
  "$description": "Nexus color tokens — source: lTheme() in landing-kit.jsx + README.md. Accent-free philosophy: hierarchy from weight+spacing, not color. One accent (plum) used only for: send/confirm, loading spinner, selected tab tint, Echo-pulse, brand mark.",

  "color": {
    "brand": {
      "plum":   { "$value": "#7054AB", "$type": "color", "$description": "Accent plum — approved uses only (see $description)" },
      "bloom":  { "$value": "#E7DCF4", "$type": "color", "$description": "Plum bloom — page background gradient start" }
    },
    "neutral": {
      "0":    { "$value": "#FFFFFF", "$type": "color" },
      "50":   { "$value": "#FBFAFD", "$type": "color", "$description": "surface3" },
      "100":  { "$value": "#F9F8FC", "$type": "color", "$description": "page gradient end" },
      "200":  { "$value": "#F4F2F9", "$type": "color", "$description": "surface2" },
      "300":  { "$value": "#EEEBF5", "$type": "color", "$description": "hair" },
      "400":  { "$value": "#E9E5F2", "$type": "color", "$description": "border" },
      "500":  { "$value": "#DCD7EA", "$type": "color", "$description": "borderStrong" },
      "600":  { "$value": "#B7B1C4", "$type": "color", "$description": "ghost" },
      "700":  { "$value": "#9A93AC", "$type": "color", "$description": "faint" },
      "800":  { "$value": "#68607A", "$type": "color", "$description": "muted" },
      "900":  { "$value": "#130E1A", "$type": "color", "$description": "ink / text" },
      "1000": { "$value": "#0A0710", "$type": "color", "$description": "deepest ink" }
    },
    "semantic": {
      "page": {
        "$value": "radial-gradient(135% 60% at 50% -8%, #E7DCF4 0%, #F9F8FC 50%)",
        "$type": "color",
        "$description": "Soft plum bloom — the ONLY ambient color on the surface. Used as page background."
      },
      "background": {
        "primary":   { "$value": "#FFFFFF",    "$type": "color", "$description": "surface" },
        "secondary": { "$value": "#F4F2F9",    "$type": "color", "$description": "surface2 — segmented control track, pill hover bg" },
        "elevated":  { "$value": "#FBFAFD",    "$type": "color", "$description": "surface3 — subtle elevated cards" },
        "overlay":   { "$value": "rgba(19,14,26,0.50)", "$type": "color", "$description": "Modal scrim (menus use transparent scrim)" }
      },
      "text": {
        "primary":   { "$value": "#130E1A", "$type": "color", "$description": "ink" },
        "secondary": { "$value": "#68607A", "$type": "color", "$description": "muted" },
        "tertiary":  { "$value": "#9A93AC", "$type": "color", "$description": "faint" },
        "disabled":  { "$value": "#B7B1C4", "$type": "color", "$description": "ghost" },
        "inverse":   { "$value": "#FFFFFF",  "$type": "color" }
      },
      "border": {
        "default": { "$value": "#E9E5F2", "$type": "color", "$description": "border" },
        "subtle":  { "$value": "#EEEBF5", "$type": "color", "$description": "hair — lightest divider" },
        "strong":  { "$value": "#DCD7EA", "$type": "color", "$description": "borderStrong — focused/active states" }
      },
      "status": {
        "success": { "$value": "#3D9E5F", "$type": "color" },
        "warning": { "$value": "#D97706", "$type": "color" },
        "error":   { "$value": "#DC2626", "$type": "color" },
        "info":    { "$value": "#7054AB", "$type": "color", "$description": "Plum — info uses the brand accent" }
      }
    },
    "dark": {
      "$description": "Dark mode overrides — deep gray, same Notion restraint as light. Not dark-first.",
      "background": {
        "primary":   { "$value": "#0F0D13", "$type": "color" },
        "secondary": { "$value": "#1A1720", "$type": "color" },
        "elevated":  { "$value": "#231F2A", "$type": "color" },
        "overlay":   { "$value": "rgba(0,0,0,0.70)", "$type": "color" }
      },
      "text": {
        "primary":   { "$value": "#F0EBF8", "$type": "color" },
        "secondary": { "$value": "#9E97B0", "$type": "color" },
        "tertiary":  { "$value": "#6B6480", "$type": "color" },
        "disabled":  { "$value": "#4A4458", "$type": "color" },
        "inverse":   { "$value": "#130E1A", "$type": "color" }
      },
      "border": {
        "default": { "$value": "#2E2A38", "$type": "color" },
        "subtle":  { "$value": "#241F2E", "$type": "color" },
        "strong":  { "$value": "#3D3850", "$type": "color" }
      }
    }
  }
}
