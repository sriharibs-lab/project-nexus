# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_ID:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres  # Supabase Postgres URI (Settings → Database → URI, pooler mode)

# ── Supabase (Settings → API Keys) ────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co                  # Project URL
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...                        # Client-side key, safe to ship in the iOS binary
SUPABASE_SECRET_KEY=sb_secret_...                                  # Server-side only; used to validate JWTs
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key           # Admin key, server-side only (magic link / OTP, admin calls)

# ── Apple Sign-In ─────────────────────────────────────────
APPLE_APP_BUNDLE_ID=com.nexus.app   # Must match the Xcode Bundle ID; empty skips the audience check (dev only, never prod)

# ── AI providers ──────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key   # Required for chat, research, briefing (Claude)
FIREWORKS_API_KEY=your-fireworks-api-key   # Required for embeddings (nomic-embed-text-v1.5) and Create-tab text artifacts
FIREWORKS_TEXT_MODEL=accounts/fireworks/models/gpt-oss-120b   # Optional; open-weights text model for quiz/infographic generation
FAL_KEY=your-fal-key                       # Required for poster image generation (fal-ai/flux/schnell); empty → poster returns 502
CHAT_MODEL=claude-sonnet-4-6               # Optional; model used for streamed chat replies
RESEARCH_MODEL=claude-haiku-4-5            # Optional; model used for "Research a topic" collection seeding
CHAT_RAG_TOP_K=8                           # Optional; similar chunks retrieved per chat query
CHAT_MAX_TOKENS=1024                       # Optional; max tokens in a streamed chat reply
RESEARCH_WEB_SEARCH_MAX_USES=6             # Optional; web_search tool calls allowed per research run

# ── Content extraction pipeline ───────────────────────────
JINA_API_KEY=your-jina-api-key             # Optional; raises Jina Reader rate limit to 200 RPM
JINA_CONNECT_TIMEOUT=10                    # Optional; seconds before Jina connect times out
JINA_READ_TIMEOUT=60                       # Optional; seconds before Jina read times out
YOUTUBE_API_KEY=your-youtube-api-key       # Optional; enables video metadata (title, channel, duration)
DEEPGRAM_API_KEY=your-deepgram-api-key     # Required for podcast / audio transcription (Nova-3)

# ── Object storage (Cloudflare R2 / S3-compatible) ────────
R2_ACCOUNT_ID=                             # Optional; if any R2 var is empty, raw content stays in Postgres TEXT
R2_ACCESS_KEY_ID=                          # R2 access key
R2_SECRET_ACCESS_KEY=                      # R2 secret key
R2_BUCKET_NAME=                            # R2 bucket for raw source content

# ── Search ────────────────────────────────────────────────
SEARCH_RESULT_LIMIT=20                     # Optional; max results returned to the client
SEARCH_TOP_K=20                            # Optional; max rows per leg (FTS / semantic) before merge
SEARCH_FTS_WEIGHT=0.3                      # Optional; weight of full-text rank in hybrid score
SEARCH_SEMANTIC_WEIGHT=0.7                 # Optional; weight of cosine similarity in hybrid score

# ── App ───────────────────────────────────────────────────
ENVIRONMENT=development                    # development | production
LOG_LEVEL=info                             # Python log level
ADMIN_TOKEN=                               # Guards /v1/admin/* (error monitor); empty → admin endpoints return 503
TRENDING_CACHE_TTL_SECONDS=900             # Optional; in-process cache TTL for Google Trends RSS
