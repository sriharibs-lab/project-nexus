# Database (Supabase connection string — Settings → Database → URI mode)
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_ID:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase (Settings → API Keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # iOS client-side key (replaces legacy anon key)
SUPABASE_SECRET_KEY=sb_secret_...             # Server-side only — never in iOS app (replaces legacy service_role key)
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json  # auto-derivable from project URL
# Service role key — NEVER expose to clients; server-side only (magic link OTP, admin calls)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# Anthropic — required for all AI endpoints (chat, research)
# Gate: 1C-008 and 1C-001 are scaffolded but will return a graceful error until this is set
ANTHROPIC_API_KEY=your-anthropic-api-key

# App
ENVIRONMENT=development
LOG_LEVEL=info

# Content Extraction Pipeline
JINA_API_KEY=your-jina-api-key          # optional; raises Jina rate limit to 200 RPM
YOUTUBE_API_KEY=your-youtube-api-key    # optional; enables video metadata (title, channel, duration)
DEEPGRAM_API_KEY=your-deepgram-api-key  # required for podcast transcription

# OpenAI (for text-embedding-3-small semantic search)
OPENAI_API_KEY=your-openai-api-key

# Apple Sign-In — required for POST /v1/auth/apple JWT verification
# Must exactly match the Bundle ID in Xcode (app target → General → Bundle Identifier)
# If omitted the audience check is skipped (acceptable for dev but NOT for TestFlight/production)
APPLE_APP_BUNDLE_ID=com.nexus.app
